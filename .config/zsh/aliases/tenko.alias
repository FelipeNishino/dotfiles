# Arch
alias update-keyring="sudo pacman -S archlinux-keyring"
alias syu="sudo pacman -Syu"
alias viewpkgs="pacman -Qq | fzf --preview 'pacman -Qil {}' --layout=reverse --bind 'enter:execute(pacman -Qil {} | less)'"
alias fdsc="cd $HOME/Projects/FractalData/FractalSated/FractalSated/fractalsated.client/"
alias fdss="cd $HOME/Projects/FractalData/FractalSated/FractalSated/FractalSated.Server/"
alias fdcc="cd $HOME/Projects/FractalData/FractalAbbottCapOp/FractalCapOp/FractalCapOp/fractalcapop.client/"
alias fdcs="cd $HOME/Projects/FractalData/FractalAbbottCapOp/FractalCapOp/FractalCapOp/FractalCapOp.Server/"
alias downgrade_pixbuf="sudo pacman -U https://archive.archlinux.org/packages/g/gdk-pixbuf2/gdk-pixbuf2-2.42.12-2-x86_64.pkg.tar.zst"

source "$ZSH_ALIASES_DIR/arch.alias"
source "$ZSH_ALIASES_DIR/tools.alias"
source "$ZSH_ALIASES_DIR/containers.alias"
